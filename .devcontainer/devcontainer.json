{
  "image": "ghcr.io/stargrid-systems/devcontainer-images/rust:1.0.0",
  // Pass the host USB bus through so avrdude/ravedude can reach the
  // MPLAB PICkit Basic (04d8:9055) for UPDI flashing. The bind mount
  // (rather than a fixed device path) survives re-plugging, since the
  // /dev/bus/usb/<bus>/<dev> node number changes each time.
  "privileged": true,
  "mounts": [
    { "source": "/dev/bus/usb", "target": "/dev/bus/usb", "type": "bind" },
    // Persists the MPLAB X install (mdb headless debugger) across
    // container rebuilds. Filled by postCreateCommand/install-mplabx.sh.
    { "source": "cellguard-mplabx", "target": "/opt/microchip", "type": "volume" }
  ],
  // Installs the mdb CLI when scratch/mplabx-linux-installer.tar.gz is
  // present; a no-op with guidance otherwise.
  "postCreateCommand": "bash .devcontainer/install-mplabx.sh"
}
